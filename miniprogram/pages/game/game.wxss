.container {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: #7ec3f2;
}
.game-canvas {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}
.hud {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  pointer-events: none;
}
/* Overlays let touches fall through to the canvas; only the interactive
   pieces (.card, .mode-btn, .mute-btn) opt back in with pointer-events: auto. */

.display {
  font-weight: 900;
  color: #fff;
}

.score {
  position: fixed;
  top: 100rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 92rpx;
  font-weight: 900;
  color: #fff;
  z-index: 101;
  pointer-events: none;
}
.score.pop { animation: pop 0.3s cubic-bezier(0.2, 1.7, 0.4, 1); }
@keyframes pop {
  0% { transform: scale(1); }
  40% { transform: scale(1.28); }
  100% { transform: scale(1); }
}

.toast {
  position: fixed;
  top: 200rpx;
  left: 25%;
  width: 50%;
  text-align: center;
  font-weight: 900;
  font-size: 36rpx;
  padding: 12rpx 36rpx;
  border-radius: 40rpx;
  color: #1f2b3d;
  z-index: 102;
  pointer-events: none;
}
.toast.reward { background-color: #ffb347; }
.toast.punish { background-color: #8b5cf6; color: #fff; }

.title-wrap {
  position: fixed;
  top: 240rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 101;
  pointer-events: none;
}
.title-text {
  font-size: 96rpx;
  font-weight: 900;
  color: #ffb347;
  text-align: center;
  margin-bottom: 32rpx;
}
.chip {
  background-color: #fff6e4;
  border-radius: 40rpx;
  padding: 18rpx 40rpx;
  font-weight: 800;
  font-size: 30rpx;
  text-align: center;
  color: #1f2b3d;
  margin-bottom: 16rpx;
}
.chip.small {
  font-size: 24rpx;
  padding: 12rpx 28rpx;
}

.hint {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-weight: 700;
  font-size: 26rpx;
  color: #1f2b3d;
  padding: 0 32rpx;
  z-index: 101;
  pointer-events: none;
}

.card {
  position: fixed;
  left: 10%;
  top: 25%;
  width: 80%;
  background-color: #fff6e4;
  border-radius: 40rpx;
  padding: 40rpx 48rpx 44rpx;
  box-sizing: border-box;
  text-align: center;
  z-index: 103;
  pointer-events: auto;
}
.eyebrow {
  font-weight: 900;
  font-size: 56rpx;
  color: #ff6b35;
}
.stats {
  display: flex;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.stat {
  flex: 1;
  background-color: #ffe9c7;
  border-radius: 28rpx;
  padding: 20rpx 16rpx;
  margin: 0 8rpx;
  text-align: center;
}
.lbl {
  font-size: 22rpx;
  font-weight: 800;
  color: #5b6b80;
}
.num {
  font-weight: 900;
  font-size: 64rpx;
  color: #1f2b3d;
}
.medal {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  min-height: 56rpx;
  margin-bottom: 8rpx;
  font-weight: 800;
  font-size: 26rpx;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #1f2b3d;
}
.disc {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 4rpx solid #1f2b3d;
  box-shadow: inset -6rpx -6rpx 0 rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}
.ribbon {
  margin-top: 12rpx;
  background-color: #ff6b35;
  color: #fff;
  border-radius: 16rpx;
  padding: 6rpx 24rpx;
  font-weight: 800;
  font-size: 24rpx;
  text-align: center;
}
.btn {
  margin-top: 32rpx;
  background-color: #1f2b3d;
  color: #fff6e4;
  border-radius: 28rpx;
  padding: 24rpx;
  font-weight: 900;
  font-size: 40rpx;
  text-align: center;
}

.mode-buttons {
  display: flex;
  gap: 24rpx;
  justify-content: center;
  margin-top: 8rpx;
}
.mode-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background-color: #fff6e4;
  border-radius: 32rpx;
  padding: 28rpx 44rpx 24rpx;
  color: #1f2b3d;
  pointer-events: auto;
}
.mode-icon { font-size: 52rpx; line-height: 1.1; }
.mode-name { font-weight: 900; font-size: 34rpx; letter-spacing: 0.02em; }
.mode-sub { font-size: 22rpx; font-weight: 700; color: #5b6b80; letter-spacing: 0.04em; }

.mode-desc { text-align: left; margin: 24rpx 0 0; }
.mode-line { font-size: 28rpx; font-weight: 600; line-height: 2; color: #1f2b3d; }
.mode-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.mode-actions .btn,
.mode-enter-btn { flex: 1; margin-top: 0; }
.btn-back {
  flex: 1;
  background-color: #ffe9c7;
  color: #1f2b3d;
  border-radius: 28rpx;
  padding: 24rpx;
  font-weight: 900;
  font-size: 36rpx;
  text-align: center;
}

.lives-display {
  position: fixed;
  top: 100rpx;
  left: 28rpx;
  display: flex;
  gap: 10rpx;
  z-index: 101;
  pointer-events: none;
}
.life {
  font-size: 48rpx;
  line-height: 1;
  color: #ff4b6e;
  transition: opacity 0.3s;
}
.life.lost { opacity: 0.22; }

.mute-btn {
  position: fixed;
  top: 100rpx;
  right: 28rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #fff6e4;
  text-align: center;
  line-height: 80rpx;
  z-index: 104;
  pointer-events: auto;
}
.mute-icon { font-size: 36rpx; }
